<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blue_primary"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Materia"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-18dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/card_surface"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_primary"
                android:hint="Nombre de la materia"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etSemestre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/blue_primary"
                android:hint="Semestre en que se cursa"
                android:inputType="number"
                android:maxLength="2" />

            <EditText
                android:id="@+id/etNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/blue_primary"
                android:hint="Calificación normal (0-100)"
                android:inputType="numberDecimal" />

            <CheckBox
                android:id="@+id/cbRepeticion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Materia de repetición"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etRepeticion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_primary"
                android:hint="Calificación de repetición (0-100)"
                android:inputType="numberDecimal"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cbEspecial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Materia en especial"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etEspecial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue_primary"
                android:hint="Calificación en especial (0-100)"
                android:inputType="numberDecimal"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/blue_primary"
                android:text="Guardar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
